[Unit]
Description=A service to pull new nvidia gpu exporter podman container images
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=900
StartLimitBurst=6

[Image]
Image=docker.io/utkuozdemir/nvidia_gpu_exporter:latest

[Service]
RemainAfterExit=no
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target default.target
